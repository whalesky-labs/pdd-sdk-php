# 真实接口测试目标，多个目标使用英文逗号分隔。
# 可选值：time-get、mall-info-get。
PDD_INTEGRATION_TARGETS=time-get

# 拼多多开放平台应用凭证；所有真实接口测试都必须填写。
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=

# 已授权商家的 Access Token；启用 mall-info-get 时必须填写。
PDD_ACCESS_TOKEN=

# 拼多多接口网关地址，通常保持默认值，仅在沙箱或代理环境中覆盖。
PDD_BASE_URL=https://gw-api.pinduoduo.com/api/router
